# ─── Database (Supabase) ──────────────────────────────────────────────────────
# Supabase dashboard → Settings → Database → Connection string
# Supabase dashboard → Settings → Database → Connection string
# DATABASE_URL: use the "Connection pooling" / "Transaction mode" string (has "pooler" in hostname)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@[pooler-host].supabase.com:[port]/postgres"

# DIRECT_URL: use the "Direct connection" string (used by Prisma migrations)
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@[direct-host].supabase.com:[port]/postgres"
JWT_SECRET="change-this-to-a-long-random-secret"

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3001

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Local dev: http://localhost:5173
# Production: your Vercel URL e.g. https://fathom.vercel.app
CLIENT_URL="http://localhost:5173"

# ─── Email (password reset) ───────────────────────────────────────────────────
# Requires a Gmail account with 2FA enabled
# Generate an App Password at: https://myaccount.google.com/apppasswords
GMAIL_USER="your-email@gmail.com"
GMAIL_APP_PASSWORD="xxxx-xxxx-xxxx-xxxx"
