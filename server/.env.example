# Supabase — pooler URL (used by Prisma at runtime)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase — direct URL (used by Prisma for migrations)
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].supabase.com:5432/postgres"

# Auth
JWT_SECRET="change-this-to-a-long-random-secret-in-production"

# Server
PORT=3001

# Frontend URL (used for CORS and password reset links)
CLIENT_URL="http://localhost:5173"

# Gmail — for password reset emails
# Use an App Password, not your account password (requires 2FA enabled)
# https://myaccount.google.com/apppasswords
GMAIL_USER="your-email@gmail.com"
GMAIL_APP_PASSWORD="your-16-char-app-password"
